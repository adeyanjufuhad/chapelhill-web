# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=
# 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible, branch endpoint)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
STORAGE_BUCKET_MEDIA=media
STORAGE_BUCKET_DOCUMENTS=client-documents

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Email (inquiry notifications via Resend)
RESEND_API_KEY=
# Verified sender, e.g. "Chapelhill <hello@chapelhill.com.ng>"
RESEND_FROM=
# Inbox that receives enquiries (defaults to the company email)
INQUIRY_NOTIFY_EMAIL=

# Contact widgets. WhatsApp number in international format, digits only, e.g. 2348032865488
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TAWK_PROPERTY_ID=

# Canonical site URL used for metadata, sitemap, Open Graph and auth redirects
NEXT_PUBLIC_SITE_URL=https://chapelhill.com.ng

# 21st.dev registry key, used only by `npx shadcn add "https://21st.dev/r/...?api_key=$API_KEY_21ST"`
API_KEY_21ST=
