# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Email (inquiry notifications)
RESEND_API_KEY=

# Contact widgets. WhatsApp number in international format, digits only, e.g. 2348032865488
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TAWK_PROPERTY_ID=

# Canonical site URL used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://chapelhill.com.ng

# 21st.dev registry key, used only by `npx shadcn add "https://21st.dev/r/...?api_key=$API_KEY_21ST"`
API_KEY_21ST=
